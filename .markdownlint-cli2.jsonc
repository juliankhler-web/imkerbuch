{
  // Regeln für unsere Dokumentation. Bewusst locker, wo die Regel nur Kosmetik
  // wäre, und streng dort, wo ein Fehler den Text unlesbar macht.
  "config": {
    "default": true,

    // MD013 Zeilenlänge: unsere Dokumente enthalten lange Tabellen und Links,
    // ein Umbruchzwang bringt hier nichts.
    "MD013": false,

    // MD024 gleiche Überschrift mehrfach: in ADRs wiederholen sich
    // „Kontext“, „Entscheidung“, „Folgen“ absichtlich – aber nur auf
    // verschiedenen Ebenen unproblematisch.
    "MD024": { "siblings_only": true },

    // MD033 eingebettetes HTML: brauchen wir für <br> in Tabellen.
    "MD033": false,

    // MD034 nackte URLs: in Quellenangaben in Ordnung.
    "MD034": false,

    // MD041 erste Zeile muss Überschrift sein: gilt, aber nicht für Vorlagen
    // mit Frontmatter.
    "MD041": true,

    // MD029 Nummerierung geordneter Listen: fortlaufend, nicht alles „1.“
    "MD029": { "style": "ordered" },

    // MD004 Aufzählungszeichen: einheitlich Bindestrich
    "MD004": { "style": "dash" },

    // MD046 Codeblöcke: immer eingezäunt (```), nie eingerückt
    "MD046": { "style": "fenced" },

    // MD049/MD050 Hervorhebung einheitlich
    "MD049": { "style": "asterisk" },
    "MD050": { "style": "asterisk" }
  },
  "globs": ["**/*.md"],
  "ignores": [
    "node_modules/**",
    "native/**",
    "website-video/**",
    "tools/coverage/**"
  ]
}
