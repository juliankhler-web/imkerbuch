<?xml version="1.0" encoding="utf-8"?>
<!-- ImkerBuch: Daten bleiben nur auf dem Gerät. Keine automatische Google-Sicherung
     und keine Übertragung beim Gerätewechsel – der Nutzer sichert selbst über
     „Sicherung speichern“ (so steht es in Datenschutzerklärung und App). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
