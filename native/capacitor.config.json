{
  "appId": "de.imkerbuch.app",
  "appName": "ImkerBuch",
  "webDir": "www",
  "ios": {
    "contentInset": "never"
  },
  "android": {
    "allowMixedContent": false,
    "minWebViewVersion": 108
  },
  "plugins": {
    "StatusBar": {
      "style": "DEFAULT"
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_imkerbuch",
      "iconColor": "#E9A21C"
    }
  },
  "server": {
    "androidScheme": "https",
    "iosScheme": "capacitor",
    "hostname": "localhost",
    "errorPath": "webview-veraltet.html"
  },
  "loggingBehavior": "none",
  "appendUserAgent": "ImkerBuch"
}
