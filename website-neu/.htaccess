Options -Indexes

# Die Seite ist statisch: PHP-Dateien werden nie ausgeführt oder ausgeliefert. Einzige Ausnahme ist der Stimmenzähler.
<FilesMatch "\.(php[0-9]?|phtml|phar)$">
  Require all denied
</FilesMatch>
<Files "stimme.php">
  Require all granted
</Files>

# Seit 08.11.2026 für Suchmaschinen freigegeben (Julian). Nicht in die Suche: QR-Hinweisseite /v/ und Lizenzen (eigenes noindex im Kopf).
<IfModule mod_headers.c>
  # Seiten immer frisch prüfen, sonst zeigen Handys nach einer Änderung noch die alte Fassung
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Die App liest diese Datei, um die Adresssuche bei Bedarf abschalten zu können.
<Files "dienste.json">
  Header set Access-Control-Allow-Origin "*"
</Files>

# QR-Aufkleber am Volk: Wer die App nicht hat, landet bei /v/<kennung> auf der Hinweisseite.
RewriteEngine On
RewriteRule ^v/[A-Za-z0-9-]+/?$ /v/index.html [L]

# Apple liest diese Datei nur als JSON (sie hat keine Dateiendung).
<Files "apple-app-site-association">
  ForceType application/json
</Files>
